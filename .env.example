# Copy real values into your existing .env -- do not commit .env to git.

OPENROUTER_API_KEY=
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Required for deepsearch (browsing) -- there's no local-Chromium fallback
# anymore, deepsearch drives a remote Browserbase browser over CDP instead
# (see messa/channels/browserbase.py). Get one free at browserbase.com;
# no BROWSERBASE_PROJECT_ID needed, the API key alone resolves the project.
BROWSERBASE_API_KEY=

# Jina Reader (tools/jina_reader.py) -- a JS-capable page read that costs no
# Browserbase session time, used by fetch_rendered_page_text (both Messa's
# own toolset and deepsearch's). Free and keyless by default: leave this
# unset to use Jina's own published free tier (20 requests/minute, no key
# needed at all). Add a key only once real usage outgrows that -- nothing
# else needs to change, this is just an optional rate-limit raise.
# MESSA_JINA_API_KEY=

# Parallel Search MCP (tools/parallel_search.py) -- a SECOND, independent
# backup provider at the same free tier as Jina Reader above (search +
# JS-rendered/PDF page reads), so one provider having a bad day doesn't push
# a read-only question into a billed deepsearch delegation. Also free and
# keyless by default -- leave unset to use Parallel's own free tier (no
# account needed at all). Add a key only once real usage outgrows it.
# MESSA_PARALLEL_API_KEY=

# Memory (messa/memory.py, migrations/027_memory.sql) -- Mem0 on top of
# Postgres/pgvector for a two-tier memory: a cheap always-on profile digest
# (read every turn via the normal DATABASE_URL pool, no extra connection)
# plus a larger day-by-day episodic archive Mem0 itself stores, searched
# only on demand and written only by a once-a-day batch job. See README's
# "Memory" section for the full design and for scripts/verify_memory_rls.py
# (a real, hands-on proof that migration 027's Row-Level Security policy
# blocks cross-user access at the database level, not just in app code).
#
# Optional -- leave unset and the whole feature no-ops cleanly (Messa just
# never mentions the digest and recall_past_conversation reports memory
# isn't set up yet); nothing else in the app depends on this.
#
# MUST be Neon's DIRECT/unpooled connection string, NOT the same pooled
# value as DATABASE_URL above -- get it from Neon's dashboard (it's the
# "Direct connection" option, distinct from the "Pooled connection" one
# DATABASE_URL already uses). This is a real requirement, not a style
# preference: the RLS mechanism below depends on a Postgres session
# variable staying set for the query that follows it on the SAME physical
# connection, which Neon's PgBouncer pooling mode doesn't guarantee across
# separate transactions -- see messa/memory.py's own module docstring.
# MESSA_MEM0_DIRECT_DATABASE_URL=

# Before relying on this in production: confirm the role in the connection
# string above does NOT have BYPASSRLS/superuser (table owners and
# superusers silently bypass Row-Level Security regardless of policies) --
#   SELECT rolname, rolsuper, rolbypassrls FROM pg_roles WHERE rolname = current_user;
# then run: python3 scripts/verify_memory_rls.py "$MESSA_MEM0_DIRECT_DATABASE_URL"
# It proves -- for real, against your own database, not just this repo's
# own test suite -- that a scoped connection genuinely cannot read, update,
# or delete another user's memory row.
#
# Which embedder Mem0 uses -- "openrouter" (default) reuses
# OPENROUTER_API_KEY with no new dependency, "fastembed" is the local/
# CPU-only fallback (no torch) if that doesn't pan out. See README.
# MESSA_MEM0_EMBEDDER_PROVIDER=openrouter

# Base URL for the public /live/<token> page (Phase 3 -- watch deepsearch's
# browser live). Leave unset until your custom domain is wired up; Messa
# just won't mention a live link until this is set to something real, e.g.
# https://live.textmessa.com (once the HF custom domain is ready) or your
# Space's own https://<you>-<space>.hf.space in the meantime.
# MESSA_LIVE_VIEW_BASE_URL=https://live.textmessa.com

# Email agent: only COMPOSIO_API_KEY is required. Each user connects their
# own Gmail (via "connect my email/gmail", or the onboarding opt-in) --
# there's no single shared connected account anymore, so no per-account id
# to set here. Everything below is optional; tools just report "not
# configured yet" until COMPOSIO_API_KEY is set.
# COMPOSIO_API_KEY=
#
# Optional: pin the Gmail auth config Composio uses instead of letting
# email_tools.py find-or-create one automatically (e.g. to use your own
# custom Gmail OAuth app instead of Composio's managed one).
# COMPOSIO_GMAIL_AUTH_CONFIG_ID=
#
# Optional: where Composio sends the user after the OAuth consent screen.
# Leave unset to use Composio's own generic "connected" page.
# COMPOSIO_GMAIL_CALLBACK_URL=

# Dynamic Integration Engine (tools/integration_tools.py) -- any of
# Composio's other 1,400+ app toolkits (Todoist, Slack, Notion, GitHub,
# ...), on top of (not replacing) the Gmail block above. Reuses
# COMPOSIO_API_KEY as-is; everything below is optional.
#
# Same idea as COMPOSIO_GMAIL_CALLBACK_URL above, but for every OTHER
# toolkit's connect flow -- kept as its own separate setting on purpose.
# COMPOSIO_CALLBACK_URL=
#
# How many candidate tools search_integration_tools hands the model per
# call. Default 8 (raised from 5 after a real production run showed 5 was
# occasionally too tight for an unscoped search -- see README). A cheap
# secondary safety margin, not the primary fix for that -- see
# search_integration_tools' own `toolkit` parameter.
# MESSA_INTEGRATION_SEARCH_RESULT_LIMIT=8
#
# Same idea as the email-connection polling settings above, generalized to
# any toolkit -- see server.py's _production_app_connection_poll_loop.
# MESSA_APP_CONNECTION_POLL_INTERVAL_SECONDS=20
# MESSA_APP_CONNECTION_REQUEST_EXPIRES_HOURS=24

# Site credentials (messa/credentials.py, migrations/021_site_credentials.sql)
# -- lets deepsearch GENERATE and SECURELY STORE a password when it creates
# a brand-new account on a site outside Composio's catalog (via
# generate_account_credential/get_account_credential in
# tools/deepsearch_tools.py), so Messa can log back in later without
# bothering you again. This is an explicit product decision (you can change
# it): the alternative would be never persisting these passwords at all.
# Optional -- leave unset and both tools refuse plainly instead of ever
# generating a password with nothing safe to encrypt it with; nothing else
# in the app is affected.
#
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat it exactly like a database password -- anyone with this key AND a
# copy of the site_credentials table can decrypt every stored password.
# Losing it permanently loses every already-stored credential (the real
# accounts on their real sites are unaffected -- only Messa's own copy of
# the password is gone); rotating it requires decrypting everything under
# the old key and re-encrypting under the new one first (no built-in
# migration tool for that in this build).
# MESSA_CREDENTIALS_ENCRYPTION_KEY=

# Messa's own personal-inbox email -- <local-part>@textmessa.com, a
# separate address Messa owns outright per user (no OAuth, not the user's
# real Gmail -- see the Composio block above for that). Free to start:
# Cloudflare Email Routing (inbound) + Resend (outbound), see
# cloudflare/personal-email-worker/ and README's "Messa's own inbox"
# section for the full setup walkthrough. Everything below is optional;
# tools just report "not configured yet" until RESEND_API_KEY is set, and
# addresses are still assigned (messa/db.py) even before that.
# MESSA_TEXTMESSA_EMAIL_DOMAIN=textmessa.com
# RESEND_API_KEY=
#
# Shared secret the Cloudflare Worker must send back on every inbound
# email it forwards -- set the SAME value here and via
# `wrangler secret put MESSA_WEBHOOK_SECRET` in cloudflare/personal-email-worker/.
# MESSA_PERSONAL_EMAIL_WEBHOOK_SECRET=

# Phase 2 -- Sendblue (iMessage/SMS/RCS channel). Required only to run
# messa/server.py; the CLI works fine without these. Get values via the
# Sendblue CLI: `sendblue login` -> `sendblue show-keys` / `sendblue lines`.
# SENDBLUE_API_KEY=
# SENDBLUE_API_SECRET=
# SENDBLUE_NUMBER=
# SENDBLUE_WEBHOOK_SECRET=                     # optional, see README Phase 2 step 3
# MESSA_SMS_AUTO_APPROVE_DESTRUCTIVE=false     # see README -- Deny is the safe default

# Per-agent OpenRouter API keys -- splits WHICH key each agent uses, so a
# rate/concurrency ceiling on one busy key/account can't queue up another
# agent's calls behind it (most importantly: never Messa's own reply to
# the user). All optional; leave unset and everything falls back to plain
# OPENROUTER_API_KEY, exactly like before this existed. See config.py's
# "Per-agent OpenRouter API keys" section for the full design.
#
# Messa's own orchestrator -- touches every single message, the most
# latency-sensitive agent by far. Worth its own dedicated key on its own.
# MESSA_ORCHESTRATOR_API_KEY=
#
# deepsearch's own TOP-LEVEL model (its browsing runs are the heaviest
# single subagent workload). Separate from MESSA_OPENROUTER_API_KEY_POOL
# below, which is specifically for deepsearch's own CONCURRENT sub-workers
# -- the two are complementary, not redundant: this is deepsearch's own
# base key, that pool is what its parallel browsing calls round-robin
# across (populate the pool with this same key plus others if you want
# deepsearch's own concurrency spread out too).
# MESSA_DEEPSEARCH_API_KEY=
#
# Shared by every OTHER subagent (executive_assistant, email_agent,
# personal_inbox_agent, document_agent, routines_agent, integrations_agent,
# admin_agent) -- these are occasional/bursty, much lighter traffic, so
# sharing one key among all of them is fine.
# MESSA_SUBAGENT_API_KEY=
#
# Fine-grained escape hatch: pull one specific subagent onto its own key,
# on top of the three-tier split above (e.g. once you have a 4th/5th key
# and want to split email_agent off from the shared group too). Format:
# "agent_name=key,agent_name=key" -- agent name exactly matching its
# subagent "name" (deepsearch, executive_assistant, email_agent,
# personal_inbox_agent, document_agent, routines_agent, integrations_agent,
# admin_agent).
# MESSA_AGENT_API_KEY_OVERRIDES=

# deepsearch's own concurrent delegate_website_task sub-workers round-robin
# across these (see tools/deepsearch_tools.py's _pick_subagent_model) --
# comma-separated, unset means a pool of exactly one (OPENROUTER_API_KEY).
# Worth populating if a real run's own per-sub-worker timing logs suggest a
# shared key's concurrent-request ceiling is queuing "parallel" browsing
# calls behind each other server-side.
# MESSA_OPENROUTER_API_KEY_POOL=

# Optional overrides (all have sensible defaults, see messa/config.py):
# MESSA_MODEL=~deepseek/deepseek-v4-pro           # Messa's own orchestrator model
# MESSA_SUBAGENT_MODEL=~deepseek/deepseek-v4-flash-latest  # deepsearch + the other 4 subagents
# MESSA_CLI_USER_PHONE=+10000000000
# MESSA_CLI_USER_NAME=              # leave unset to go through onboarding as a new user
# MESSA_DEFAULT_TIMEZONE=America/New_York
# MESSA_DEEPSEARCH_ALLOWED_DOMAINS=example.com,another.com
# MESSA_DEEPSEARCH_MAX_STEPS=100       # step budget per delegation before saving progress + stopping
# MESSA_SESSIONS_DIR=sessions
# MESSA_OUTPUTS_DIR=outputs

# New-user signup cap + waitlist (messa/waitlist.py, migrations/025) -- caps
# how many BRAND NEW people can sign up counting only from the moment you
# set this, never touching anyone who already texted Messa before. 0 (the
# default) means unlimited/off -- completely non-destructive, nothing
# changes until you set a real number. Once a number is set, anyone over
# the cap gets a one-time "you're on the waitlist" text instead of being
# onboarded; an admin can let individual people in early via
# admit_from_waitlist without raising the cap for everyone else.
# MESSA_NEW_USER_CAP=0
#
# Admin broadcast (messa/tools/admin_tools.py, migrations/026) -- how many
# broadcast sends run concurrently against Sendblue at once. Default 20 is
# plenty for normal user counts; only raise it if you have a large user
# base and broadcasts are taking too long to fan out.
# MESSA_BROADCAST_MAX_CONCURRENT_SENDS=20


#npx skills add ComposioHQ/composio --skill composio -y