# Copy real values into your existing .env -- do not commit .env to git.

OPENROUTER_API_KEY=
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Optional -- email agent (Phase 1 runs fine without these; tools just
# report "not configured yet" until set):
# COMPOSIO_API_KEY=
# COMPOSIO_EMAIL_CONNECTED_ACCOUNT_ID=

# Optional overrides (all have sensible defaults, see messa/config.py):
